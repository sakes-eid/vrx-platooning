<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>platoon_tuning</name>
  <version>0.0.0</version>
  <description>Automated controller tuning framework for the VRX multi-vessel platooning project.</description>
  <maintainer email="eids4576@gmail.com">sajed</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  

<exec_depend>python3-yaml</exec_depend>
<exec_depend>ament_index_python</exec_depend>

<exec_depend>vrx_gz</exec_depend>
<exec_depend>platoon_state</exec_depend>
<exec_depend>platoon_planner</exec_depend>
<exec_depend>platoon_control</exec_depend>
<exec_depend>platoon_monitor</exec_depend>
<exec_depend>platoon_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
